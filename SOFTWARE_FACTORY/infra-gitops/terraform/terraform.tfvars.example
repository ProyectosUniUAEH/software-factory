# ==============================================================================
# KAANBAL ENGINE - TERRAFORM VARIABLES (EXAMPLE)
# ==============================================================================
# Copy this file to terraform.tfvars and fill in YOUR values.
# This is the ONLY file where credentials/config should go.
#
# SETUP:
#   1. Copy: cp terraform.tfvars.example terraform.tfvars
#   2. Fill in ALL values below
#   3. Run: cd ..; .\scripts\bootstrap-manifests.ps1  (updates K8s manifests)
#   4. Commit & push infra-gitops repo
#   5. Run: terraform init && terraform apply
#   6. Wait ~10 min for cluster bootstrap
#   7. Vault auto-initializes via K8s Job
#   8. Open Kaanbal Console and configure Settings
# ==============================================================================

# --- Instance Configuration ---
# Master: runs Kubernetes control plane (tainted, no workloads)
# Workers: run ALL pods (container workloads)
instance_type_override = "m7i-flex.large"   # Master node type
instance_profile       = "medium"            # Disk profile (50GB)

# --- Auto Scaling Workers ---
worker_instance_type = "c7i-flex.large"      # Worker node type
worker_min_count     = 2                     # Min workers (2 for multi-AZ EBS)
worker_max_count     = 5                     # Max workers (Cluster Autoscaler)

# --- AWS Credentials ---
# Create an IAM user with EC2/EBS/KMS permissions, or use AWS CLI profile
aws_access_key = ""
aws_secret_key = ""
# aws_region   = "us-east-2"  # Uncomment to override default

# --- Domain & Network ---
# You need: 1) A domain with DNS pointing to the elastic IP
#           2) An Elastic IP allocated in your AWS account
domain_name              = "yourdomain.com"
elastic_ip               = "x.x.x.x"
elastic_ip_allocation_id = "eipalloc-XXXXXXXXXXXXXXXXX"

# --- SSH & SSL ---
ssh_key_name         = "factory"
email_letsencrypt    = "your-email@example.com"
ssh_private_key_path = "/path/to/your/factory.pem"  # Generated by terraform

# --- Git/Bitbucket Configuration ---
# ArgoCD uses these to connect to your private infra-gitops repo
# Create a Bitbucket App Password with: Repositories (Read), Pipelines (R/W)
git_username        = "YourBitbucketUsername"
git_token           = "YOUR_BITBUCKET_APP_PASSWORD"
bitbucket_email     = "your-email@example.com"
bitbucket_workspace = "your-bitbucket-workspace"   # Workspace slug

# --- Docker Hub Configuration ---
# Used for pushing container images from CI pipelines
# Create an access token at https://hub.docker.com/settings/security
docker_username = "yourdockerhubuser"
docker_token    = "dckr_pat_XXXXXXXXXXXX"

# --- ArgoCD Configuration ---
# Custom admin password (leave empty to auto-generate)
argocd_admin_password = ""

# --- Tailscale Configuration ---
# Required for private VPN access to cluster services
# Create OAuth client at: https://login.tailscale.com/admin/settings/oauth
# Scopes: Devices Write, Auth Keys Write, ACL Read/Write
# Tag: tag:k8s-operator
tailscale_client_id     = ""
tailscale_client_secret = ""

# --- Vault Configuration ---
# LEAVE EMPTY for initial setup. Vault auto-initializes via K8s Job.
# The root token is stored in K8s secret: vault/vault-init-keys
# Only fill this if you want Terraform to configure Vault policies:
#   kubectl -n vault get secret vault-init-keys -o jsonpath='{.data.root-token}' | base64 -d
vault_init_token = ""

# --- AI Configuration (optional) ---
# Used for error analysis and summaries in the platform
# Supported providers: deepseek, openai, anthropic
ai_provider = "deepseek"
ai_api_key  = ""
ai_model    = "deepseek-chat"
ai_base_url = "https://api.deepseek.com"

