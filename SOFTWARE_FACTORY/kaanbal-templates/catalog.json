{
  "version": "4.1.0",
  "categories": {
    "frontend": {
      "name": "Frontend",
      "icon": "🎨",
      "description": "Web applications"
    },
    "backend": {
      "name": "Backend",
      "icon": "⚙️",
      "description": "APIs and services"
    },
    "database": {
      "name": "Database",
      "icon": "💾",
      "description": "Data storage"
    },
    "workflow": {
      "name": "Workflow",
      "icon": "🔄",
      "description": "Automation"
    },
    "iot": {
      "name": "IoT / Messaging",
      "icon": "📡",
      "description": "MQTT brokers and device messaging"
    }
  },
  "templates": [
    {
      "id": "vue3-spa",
      "name": "Vue 3 SPA",
      "description": "Vue 3 + Vite static site served by nginx",
      "icon": "vue",
      "color": "#42b883",
      "category": "frontend",
      "stack": ["vue3", "vite"],
      "popular": true,
      "status": "ready",
      "port": 80,
      "service_type": "http",
      "creation_modes": ["scaffold", "empty", "upload"],
      "secrets": [
        {"name": "APP_SECRET", "auto_generate": true, "length": 32}
      ]
    },
    {
      "id": "react-spa",
      "name": "React SPA",
      "description": "React + Vite static site served by nginx",
      "icon": "react",
      "color": "#61dafb",
      "category": "frontend",
      "stack": ["react", "vite"],
      "popular": true,
      "status": "ready",
      "port": 80,
      "service_type": "http",
      "creation_modes": ["scaffold", "empty", "upload"],
      "secrets": [
        {"name": "APP_SECRET", "auto_generate": true, "length": 32}
      ]
    },
    {
      "id": "fastapi-api",
      "name": "FastAPI",
      "description": "Python FastAPI service (REST + optional WebSocket)",
      "icon": "python",
      "color": "#009688",
      "category": "backend",
      "stack": ["python", "fastapi"],
      "popular": true,
      "status": "ready",
      "port": 8000,
      "service_type": "http",
      "creation_modes": ["scaffold", "empty", "upload"],
      "secrets": [
        {"name": "APP_SECRET", "auto_generate": true, "length": 32}
      ]
    },
    {
      "id": "mongodb",
      "name": "MongoDB",
      "description": "MongoDB document database — secrets in Vault; bind from Wizard",
      "icon": "mongodb",
      "color": "#47a248",
      "category": "database",
      "stack": ["mongodb"],
      "popular": true,
      "status": "ready",
      "port": 27017,
      "service_type": "tcp",
      "needs_repo": false,
      "creation_modes": ["config-only"],
      "docker_image": "mongo:7",
      "tailscale_tags": ["tag:k8s", "tag:database"],
      "volumes": [
        {"name": "data", "mount_path": "/data/db", "size": "5Gi"}
      ],
      "secrets": [
        {"name": "MONGO_INITDB_ROOT_USERNAME", "auto_generate": false, "pattern": "{env_prefix}admin"},
        {"name": "MONGO_INITDB_ROOT_PASSWORD", "auto_generate": true, "length": 24},
        {"name": "MONGO_INITDB_DATABASE", "auto_generate": false, "pattern": "{app_name_underscore}"}
      ]
    },
    {
      "id": "postgres",
      "name": "PostgreSQL",
      "description": "PostgreSQL database — secrets in Vault; bind from Wizard",
      "icon": "postgres",
      "color": "#336791",
      "category": "database",
      "stack": ["postgresql"],
      "popular": true,
      "status": "ready",
      "port": 5432,
      "service_type": "tcp",
      "needs_repo": false,
      "creation_modes": ["config-only"],
      "docker_image": "postgres:16",
      "tailscale_tags": ["tag:k8s", "tag:database"],
      "volumes": [
        {"name": "data", "mount_path": "/var/lib/postgresql/data", "size": "5Gi"}
      ],
      "env_vars": [
        {"name": "PGDATA", "value": "/var/lib/postgresql/data/pgdata"}
      ],
      "secrets": [
        {"name": "POSTGRES_USER", "auto_generate": false, "pattern": "{env_prefix}admin"},
        {"name": "POSTGRES_PASSWORD", "auto_generate": true, "length": 24},
        {"name": "POSTGRES_DB", "auto_generate": false, "pattern": "{app_name_underscore}"}
      ]
    },
    {
      "id": "n8n",
      "name": "n8n",
      "description": "Workflow automation — choose Public or VPN per environment (full channel)",
      "icon": "n8n",
      "color": "#ff6d5a",
      "category": "workflow",
      "stack": ["n8n"],
      "popular": true,
      "status": "ready",
      "port": 5678,
      "service_type": "http",
      "needs_repo": false,
      "creation_modes": ["config-only"],
      "docker_image": "n8nio/n8n:latest",
      "resources": {
        "requests": {"cpu": "100m", "memory": "512Mi"},
        "limits": {"cpu": "1000m", "memory": "2Gi"}
      },
      "env_vars": [
        {"name": "N8N_LISTEN_ADDRESS", "default": "0.0.0.0"},
        {"name": "N8N_PORT", "default": "5678"},
        {"name": "NODE_OPTIONS", "default": "--max-old-space-size=1024"},
        {"name": "N8N_DIAGNOSTICS_ENABLED", "default": "false"},
        {"name": "N8N_EDITOR_BASE_URL", "default": "https://{{APP_NAME}}.{{DOMAIN}}"},
        {"name": "WEBHOOK_URL", "default": "https://{{APP_NAME}}.{{DOMAIN}}/"}
      ],
      "volumes": [
        {"name": "data", "mount_path": "/home/node/.n8n", "size": "2Gi"}
      ],
      "exposure": {
        "mode": "public",
        "surfaces": {
          "ui":      { "via": "auto", "path": "/", "label": "n8n UI" },
          "webhook": { "via": "auto", "path": "/webhook/", "label": "Webhooks" },
          "mcp":     { "via": "auto", "path": "/mcp/", "label": "MCP server" }
        }
      },
      "secrets": [
        {"name": "N8N_ENCRYPTION_KEY", "auto_generate": true, "length": 32}
      ]
    },
    {
      "id": "emqx",
      "name": "EMQX",
      "description": "MQTT broker (dashboard + MQTT + WebSocket)",
      "icon": "emqx",
      "color": "#5e6ad2",
      "category": "iot",
      "stack": ["mqtt", "emqx"],
      "popular": true,
      "status": "ready",
      "port": 18083,
      "service_type": "http",
      "needs_repo": false,
      "creation_modes": ["config-only"],
      "docker_image": "emqx/emqx:5.8.3",
      "tailscale_tags": ["tag:k8s", "tag:iot"],
      "ports": [
        {"name": "mqtt", "port": 1883, "protocol": "TCP"},
        {"name": "ws", "port": 8083, "protocol": "TCP"},
        {"name": "dashboard", "port": 18083, "protocol": "TCP"}
      ],
      "tailscale_tcp_ports": ["mqtt", "ws"],
      "port_defaults": {
        "mqtt": "tailscale",
        "ws": "tailscale",
        "dashboard": "tailscale"
      },
      "exposure": {
        "mode": "tailscale",
        "surfaces": {
          "dashboard": { "via": "auto", "path": "/", "label": "Dashboard (L7 HTTP)" },
          "mqtt":      { "via": "tcp",  "path": "",  "label": "MQTT (L4 :1883)" },
          "ws":        { "via": "tcp",  "path": "",  "label": "MQTT over WS (L4 :8083)" }
        }
      },
      "secrets": [
        {"name": "EMQX_DASHBOARD__DEFAULT_USERNAME", "auto_generate": false, "pattern": "admin"},
        {"name": "EMQX_DASHBOARD__DEFAULT_PASSWORD", "auto_generate": true, "length": 24}
      ]
    }
  ],
  "stacks": [],
  "exposure_modes": {
    "public": {"name": "Public (HTTPS)", "icon": "🌐", "description": "Ingress + Cloudflare subdomain"},
    "tailscale": {"name": "Private VPN", "icon": "🔒", "description": "Tailscale MagicDNS"},
    "both": {"name": "Mixed", "icon": "🔀", "description": "Public paths + VPN for the rest (e.g. n8n webhooks)"},
    "lan": {"name": "LAN", "icon": "📡", "description": "NodePort on cluster LAN IP"},
    "internal": {"name": "Cluster only", "icon": "🏠", "description": "{app}.{env}.svc.cluster.local"},
    "off": {"name": "Off", "icon": "⏹", "description": "No exposure, replicas=0"}
  }
}
