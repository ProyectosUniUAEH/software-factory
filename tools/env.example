# Kaanbal — variables de entorno (plantilla)
# Copiar a ~/.kaanbal/env (global, fuera de git) o .env.local por repo.
# NUNCA commitear valores reales.
# El wizard también acepta los aliases sin prefijo usados por el instalador:
# GITHUB_ORG, GITOPS_TOKEN, DOMAIN, CF_TOKEN, CF_ACCOUNT_ID, etc.

# --- GitHub (instalador + AppDeployer) ---
KB_GIT_PROVIDER=github
KB_GIT_ORG=ProyectosUniUAEH
KB_GIT_USERNAME=
KB_GIT_TOKEN=

# --- Docker Hub ---
KB_DOCKER_USER=
KB_DOCKER_TOKEN=

# --- Cloudflare ---
KB_CLOUDFLARE_TOKEN=
KB_CLOUDFLARE_ACCOUNT_ID=
KB_DOMAIN=

# --- Tailscale (OAuth app) ---
KB_TAILSCALE_CLIENT_ID=
KB_TAILSCALE_CLIENT_SECRET=
TAILSCALE_DNS_SUFFIX=

# --- Servidor lab ---
KB_LAB_HOST=192.168.1.198
KB_LAB_USER=andres
KB_LAB_SSH_ALIAS=andres-lan

# --- Jira / Atlassian (MCP OAuth — no token en archivo) ---
KB_JIRA_SITE=asistenteia97.atlassian.net
KB_JIRA_PROJECT=SF

# --- Miro ---
KB_MIRO_BOARD_URL=https://miro.com/app/board/uXjVH3hIUGE=/

# --- Infra repos (post-instalación, org del cliente) ---
KB_INFRA_REPO=infra-gitops
KB_TEMPLATES_REPO=kaanbal-templates

# --- Acceso administrativo post-instalación ---
# Mínimo 12 caracteres. Se guarda solo en /etc/kaanbal/installer.env (modo 600)
# y como Secret kaanbal-bootstrap-creds dentro del cluster.
KAANBAL_ADMIN_USER=admin
KAANBAL_ADMIN_PASS=

# --- Opcional: AI providers (instalador) ---
# KB_AI_PROVIDER=
# KB_AI_API_KEY=
